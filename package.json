{
  "name": "yuk-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run admin:build && npm run start -w @yuk/api",
    "api": "npm run start -w @yuk/api -- --no-autostart",
    "api:dev": "npm run dev -w @yuk/api",
    "admin": "npm run dev -w @yuk/admin",
    "admin:build": "npm run build -w @yuk/admin",
    "parse": "npm run parse -w @yuk/parser --",
    "parse:eval": "npm run eval -w @yuk/parser --",
    "tg:login": "npm run login -w @yuk/collector",
    "tg:dialogs": "npm run dialogs -w @yuk/collector",
    "tg:search": "npm run search -w @yuk/collector --",
    "tg:export": "npm run export -w @yuk/collector --",
    "tg:logout": "npm run logout -w @yuk/collector",
    "tg:live": "npm run live -w @yuk/collector --",
    "bot": "npm run start -w @yuk/bot --",
    "bot:check": "npm run check -w @yuk/bot",
    "web": "npm run dev -w @yuk/web",
    "web:build": "npm run build -w @yuk/web",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13"
  }
}
