{
  "name": "@yuk/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "node --env-file-if-exists=../../.env src/cli.js login",
    "dialogs": "node --env-file-if-exists=../../.env src/cli.js dialogs",
    "search": "node --env-file-if-exists=../../.env src/cli.js search",
    "export": "node --env-file-if-exists=../../.env src/cli.js export",
    "logout": "node --env-file-if-exists=../../.env src/cli.js logout",
    "live": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/cli.js live",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "ops": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/ops.js"
  },
  "dependencies": {
    "@yuk/parser": "*",
    "@yuk/shared": "*",
    "@yuk/store": "*",
    "telegram": "^2.26.22"
  }
}
