# Nusxa oling: .env.example → .env, va qiymatlarni O'ZINGIZ yozing.
# .env faylni hech qachon gitga yoki chatga yubormang.

# --- AI parser ---
# Qaysi AI: gemini (standart, bepul) yoki claude (pullik)
PARSER_PROVIDER=

# Gemini — bepul kalit: aistudio.google.com → Get API key
GEMINI_API_KEY=

# Claude — pullik: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Ixtiyoriy. Bo'sh qolsa: gemini → gemini-flash-lite-latest, claude → claude-opus-5-5
# Mavjud modellar ro'yxati: npm run parse -- --models
PARSER_MODEL=
# Ixtiyoriy, faqat Claude uchun: low | medium | high (standart: low)
PARSER_EFFORT=

# --- Telegram bot (@BotFather → /newbot) ---
BOT_TOKEN=
# Yuklar joylanadigan kanal: @kanal_nomi yoki -100... (bot kanalda "Post messages" huquqli admin bo'lishi kerak)
CHANNEL_ID=
# /holat buyrug'ini ko'ra oladiganlar: Telegram id, vergul bilan (o'z id'ingiz: botga /id yozing)
ADMIN_IDS=
# Mini App (apps/web) joylangan https manzil. Bo'sh qolsa, sozlamalar chatda savol-javob bilan bo'ladi.
# Qanday joylash: apps/web/README.md (Cloudflare Pages, bepul)
MINIAPP_URL=
# "📱 Ilovalar" tugmasi uchun, ixtiyoriy. Do'kon havolalari (https):
ANDROID_URL=
IOS_URL=
# Yoki Android o'rnatish fayli, YukPlatform papkasiga nisbatan (50 MB gacha), masalan: data/apk/yuk-ekspert.apk
APK_FILE=

# --- Userbot / collector (my.telegram.org → API development tools) ---
# Alohida telefon raqamdagi akkaunt ishlating.
TG_API_ID=
TG_API_HASH=
# Odatda bo'sh qoladi: `npm run tg:login` sessiyani apps/collector/telegram.session ga saqlaydi.
# Faqat serverda, fayl o'rniga kerak bo'lsa yoziladi. Bu akkauntga to'liq kirish kaliti!
TG_SESSION=
# Jonli rejimda kuzatiladigan ochiq guruhlar, vergul bilan. Faqat BIRINCHI marta o'qiladi:
# keyin ro'yxat bazada, boshqaruv markazining «Manbalar» bo'limidan o'zgartiriladi.
TG_SOURCES=@yuk_markazi_gruupa,@yuklar_isuzi_furalar,@TutGruz,@toshkent_namangan_labo,@LOGISTICA_UZBEKISTAN

# --- Boshqaruv markazi (npm start → http://localhost:3000/admin), ixtiyoriy ---
# Port (standart 3000)
API_PORT=
# npm start da o'zi yoqiladiganlar (standart: bot,collector). Hech biri kerak bo'lmasa: AUTOSTART=none
AUTOSTART=

# --- Baza ---
# Hozir: SQLite fayli data/yuk.db (sozlash shart emas). Sinash uchun boshqa fayl: YUK_DB=data/sinov.db
YUK_DB=
# Keyin, apps/api bilan: PostgreSQL
DATABASE_URL=
