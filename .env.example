# Nusxa oling: .env.example → .env, va qiymatlarni O'ZINGIZ yozing.
# .env faylni hech qachon gitga yoki chatga yubormang.

# --- AI parser ---
# Qaysi AI (npm run parse uchun): gemini (standart, bepul), onepro (1pro.uz), groq, openrouter yoki claude (pullik).
# Bot esa yozilgan hamma kalitni birga ishlatadi (boshqaruv markazi → AI).
PARSER_PROVIDER=

# Gemini — bepul kalit: aistudio.google.com → Get API key
GEMINI_API_KEY=

# 1pro.uz — OpenAI-mos API (https://1pro.uz/v1), model qwen3.8-flash.
# Limit: kuniga 1 000 000 javob (output) tokeni, Toshkent vaqti bilan 00:00 da yangilanadi.
ONEPRO_API_KEY=
# Ixtiyoriy, manzil o'zgarsa: ONEPRO_BASE_URL=https://1pro.uz/v1

# Groq — bepul kalit: console.groq.com/keys (gsk_...). Har model: daqiqasiga 8 000 token, kuniga 200 000 token.
GROQ_API_KEY=

# OpenRouter — openrouter.ai/keys (sk-or-v1-...). Faqat ":free" modellar ishlatiladi, pul yechilmaydi.
# Limit: kuniga 50 so'rov (hamma bepul model birga), Toshkent vaqti bilan 05:00 da yangilanadi.
OPENROUTER_API_KEY=

# Claude — pullik: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Ixtiyoriy. Bo'sh qolsa: gemini → gemini-flash-lite-latest, onepro → qwen3.8-flash, claude → claude-opus-5-5
# Mavjud modellar ro'yxati: npm run parse -- --models
PARSER_MODEL=
# Ixtiyoriy, faqat Claude uchun: low | medium | high (standart: low)
PARSER_EFFORT=
# Bot bir vaqtda nechta AI so'rovi yuboradi (standart: 8). AI kalitlari va modellari —
# boshqaruv markazining «AI» bo'limida (yuqoridagi kalit u yerga birinchi marta o'zi qo'shiladi)
PARSER_PARALLEL=
# Ixtiyoriy. Bitta AI so'rovidagi e'lonlar (standart: 10) va navbat to'lmasa necha soniya yig'ib turish (standart: 90).
# Bepul kunlik limit kechgacha yetmasa: PARSER_BATCH=15, PARSER_BATCH_WAIT=180 (packages/parser/README.md)
PARSER_BATCH=
PARSER_BATCH_WAIT=
# Jonli kelgan e'lon (collector akkaunti a'zo bo'lgan guruhdan) uchun yig'ib turish, soniya (standart: 30)
PARSER_LIVE_WAIT=

# --- Telegram bot (@BotFather → /newbot) ---
BOT_TOKEN=
# Loyihaning kanali: @kanal_nomi yoki -100... Bot o'z kanalidagi postlarni yangi e'lon deb olmasligi uchun kerak
CHANNEL_ID=
# Yuklarni kanalga ham joylash: 1 — ha. Standart — yo'q: yuklar faqat mos haydovchilarga shaxsiy xabarda boradi
# (bot kanalda "Post messages" huquqli admin bo'lishi kerak)
CHANNEL_LOADS=
# Bot faqat shu kanal va guruh a'zolariga ishlaydi: @nom yoki -100..., vergul bilan. Bo'sh — hammaga.
# A'zo bo'lmagan odamga «a'zo bo'ling» xabari va tugmalar chiqadi, yuk yuborilmaydi (kuniga bir marta eslatiladi).
# Bot ikkalasida ham ADMIN bo'lishi kerak — aks holda Telegram boshqa odamning a'zoligini aytmaydi
REQUIRED_CHATS=@Yuk_Ekspert,@Yuk_Ekspert_chat
# Qaysi yo'nalishdagi yuklar kanalga chiqadi va haydovchilarga boradi (standart: qoshni):
#   qoshni  — O'zbekiston ichi va O'zbekiston ↔ Qozog'iston, Qirg'iziston, Tojikiston, Turkmaniston, Afg'oniston
#   ichki   — faqat O'zbekiston ichi;  hammasi — cheklovsiz (Rossiya, Belarus, Xitoy...)
ROUTE_SCOPE=
# Joylanganiga necha soatdan oshgan e'lon AI'ga bormaydi va «Eskirgan» deb yopiladi (standart: 3; 0 — cheklovsiz).
# Bot o'chib turgan paytda to'plangan kechagi e'lonlar kanalga "yangi yuk" bo'lib chiqmaydi va AI limitini yemaydi
POST_MAX_AGE_HOURS=
# AI'siz qoidaviy parser: oddiy e'lonni (yo'nalish, mashina, og'irlik aniq) AI kutmasdan darhol tushunib yuboradi,
# qolganini AI tahlil qiladi. Standart: yoqiq; 0 — o'chiq (hamma e'lon AI'ga). Solishtirish: npm run parse:rules
RULE_PARSER=
# Aloqasiz e'lonlar: matnda telefon raqami ham, yozgan odamning username'i («💬 Lichkasi») ham yo'q bo'lsa — e'lon AI'ga
# ham, foydalanuvchilarga ham bormaydi (boshqaruv markazida «Aloqasiz» deb ko'rinadi). Standart: yoqiq; 0 — o'chiq
REQUIRE_CONTACT=
# /holat buyrug'ini ko'ra oladiganlar: Telegram id, vergul bilan (o'z id'ingiz: botga /id yozing)
ADMIN_IDS=
# Haydovchilar ilovasining (apps/web) DOIMIY https manzili — faqat o'z domeningiz bo'lsa.
# Bo'sh qolsa: bot npm start yoqqan tunnel manzilini o'zi oladi; tunnel o'chiq bo'lsa — sozlamalar chatda savol-javob.
# Batafsil: apps/api/README.md «Internetga chiqarish: nginx + tunnel»
MINIAPP_URL=
# "📱 Ilovalar" tugmasi uchun, ixtiyoriy. Do'kon havolalari (https):
ANDROID_URL=
IOS_URL=
# Yoki Android o'rnatish fayli, YukPlatform papkasiga nisbatan (50 MB gacha), masalan: data/apk/yuk-ekspert.apk
APK_FILE=

# --- Userbot / collector (my.telegram.org → API development tools) ---
# Alohida telefon raqamdagi akkaunt ishlating.
TG_API_ID=
TG_API_HASH=
# Odatda bo'sh qoladi: `npm run tg:login` sessiyani apps/collector/telegram.session ga saqlaydi.
# Faqat serverda, fayl o'rniga kerak bo'lsa yoziladi. Bu akkauntga to'liq kirish kaliti!
TG_SESSION=
# Jonli rejimda kuzatiladigan ochiq guruhlar, vergul bilan. Faqat BIRINCHI marta o'qiladi:
# keyin ro'yxat bazada, boshqaruv markazining «Manbalar» bo'limidan o'zgartiriladi.
TG_SOURCES=@yuk_markazi_gruupa,@yuklar_isuzi_furalar,@TutGruz,@toshkent_namangan_labo,@LOGISTICA_UZBEKISTAN

# --- Boshqaruv markazi (npm start → http://localhost:3000/admin), ixtiyoriy ---
# Port (standart 3000)
API_PORT=
# npm start da o'zi yoqiladiganlar (standart: nginx,tunnel,bot,collector — kompyuterda o'rnatilganlari). Hech biri: AUTOSTART=none
AUTOSTART=

# --- Haydovchilar ilovasi, nginx va tunnel (npm start → http://localhost), ixtiyoriy ---
# Haydovchilar serveri porti (standart 3001). nginx /pub so'rovlarini shunga uzatadi
PUBLIC_PORT=
# nginx porti (standart 80). 80 band bo'lsa: NGINX_PORT=8080
NGINX_PORT=
# Qaysi tunnel: auto (standart) — Tailscale o'rnatilgan va ulangan bo'lsa Tailscale Funnel (DOIMIY manzil
# https://<kompyuter>.<tarmoq>.ts.net), bo'lmasa Cloudflare (manzil har ishga tushganda yangi). tailscale | cloudflare — faqat o'sha
TUNNEL=
# Tunnel qayerga ulanadi (standart: nginx; nginx yo'q bo'lsa http://127.0.0.1:3001). 3000 — hech qachon
TUNNEL_TARGET=
# Doimiy manzil bo'lsa, faqat ko'rsatish uchun (tunnel ishlasa, o'zi ko'rsatiladi)
PUBLIC_URL=
# nginx.exe / cloudflared.exe / tailscale.exe boshqa joyda bo'lsa — to'liq yo'li (odatda o'zi topadi: tools/nginx-*/, Program Files)
NGINX_EXE=
CLOUDFLARED_EXE=
TAILSCALE_EXE=

# --- Baza ---
# Hozir: SQLite fayli data/yuk.db (sozlash shart emas). Sinash uchun boshqa fayl: YUK_DB=data/sinov.db
YUK_DB=
# Keyin, apps/api bilan: PostgreSQL
DATABASE_URL=

# --- Lokal dasturlash rejimi (2026-11-13) ---
# Loyiha serverda ishlaydi (https://yuk.gtpro.uz). Kompyuterdagi nusxa unga xalaqit bermasligi uchun FAQAT kompyuterdagi
# .env ga: YUK_ENV=dev (serverda bu qator bo'lmaydi). Shunda (@yuk/shared devMode.js):
#   • bot prod bot (PROD_BOTS) tokeni bilan ishga tushmaydi — BOT_TOKEN ga test bot tokeni (@BotFather → /newbot);
#   • collector Telegram akkauntini ishlatmaydi (tg:login dan tashqari), AUTOSTART uni yoqmaydi;
#   • alohida baza tavsiya etiladi: YUK_DB=data/dev.db
YUK_ENV=
# Serverdagi (haqiqiy) botlar ro'yxati, vergul bilan. Standart: @Yuk_Ekspert_agent
PROD_BOTS=
# Lokal collector ALOHIDA akkaunt bilan kerak bo'lsa (npm run tg:login, TG_SESSION qatori bo'lmasin): DEV_COLLECTOR=1
DEV_COLLECTOR=
